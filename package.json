{
  "name": "sql-data-generator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @sql-data-generator/server\" \"npm run dev -w @sql-data-generator/client\"",
    "dev:client": "npm run dev -w @sql-data-generator/client",
    "dev:server": "npm run dev -w @sql-data-generator/server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build -w @sql-data-generator/client",
    "build:server": "npm run build -w @sql-data-generator/server",
    "test": "npm run test -w @sql-data-generator/server",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "yaml": "^2.9.0"
  }
}
